# X-Ray Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ─────────────────────────────────────────────
# IBM watsonx.ai Credentials
# ─────────────────────────────────────────────

# Your IBM Cloud API key
# Get from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# The watsonx.ai service URL for your region
# Example: https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Your watsonx.ai project ID
# Find in your watsonx.ai project settings
WATSONX_PROJECT_ID=your_project_id_here



# Model to use for analysis and explanation
# Options:
#   ibm/granite-13b-chat-v2          (recommended)
#   meta-llama/llama-3-70b-instruct  (alternative)
#   ibm/granite-3-8b-instruct        (faster/cheaper)
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ─────────────────────────────────────────────
# AI Provider Selection
# ─────────────────────────────────────────────

# Set to "watsonx" to use IBM watsonx.ai (requires credentials above)
# Set to "mock" to use the built-in mock adapter (no API key needed)
# The mock adapter is useful for development and demo fallback.
AI_PROVIDER=watsonx

# ─────────────────────────────────────────────
# Backend Configuration
# ─────────────────────────────────────────────

# Directory where uploaded repositories are stored
# Default: /tmp/xray  (auto-created if it doesn't exist)
UPLOAD_DIR=/tmp/xray

# Maximum upload size in megabytes
# Uploads larger than this will be rejected
MAX_UPLOAD_SIZE_MB=50

# How long (in seconds) to keep a scanned repository before cleanup
# Default: 3600 (1 hour)
REPO_TTL_SECONDS=3600

# Backend server port
BACKEND_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# Frontend Configuration
# ─────────────────────────────────────────────

# The URL of the backend API (used by the frontend)
# Default: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
